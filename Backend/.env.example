# Server
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=f1_race_report
DB_USER=root
DB_PASSWORD=

# Groq AI
GROQ_API_KEY=
